# Secrets : la clé OpenAlex va dans une variable d'environnement, jamais ici
.env
*.key

# Données : stockées sur MinIO (SSPCloud), pas dans Git
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Exception : les embeddings, longs à recalculer, sont versionnés (voir src/embeddings.py)
!data/processed/embeddings_*.parquet

# Python / Jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
